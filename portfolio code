        function renderProjectsGrid(filter = 'all') {
            const container = document.getElementById('projectsGrid');
            container.innerHTML = '';

            Object.keys(projectsData).forEach(id => {
                const project = projectsData[id];
                
                if (filter !== 'all' && project.filterGroup !== filter) {
                    return;
                }

                const card = document.createElement('div');
                card.className = "p-6 rounded-3xl bg-slateDark border border-slate-800 hover:border-indigoAccent/60 transition-all duration-300 flex flex-col justify-between group shadow-xl hover:-translate-y-1";
                card.innerHTML = `
                    <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <span class="px-2.5 py-1 rounded-full bg-slate-900 text-goldAccent text-[11px] font-bold border border-slate-700">${project.country}</span>
                            <span class="text-xs text-indigo-400 font-semibold">${project.category}</span>
                        </div>

                        <h3 class="text-xl font-bold text-slateTextPrimary group-hover:text-indigoAccent transition-colors">${project.title}</h3>

                        <div class="space-y-2 text-xs">
                            <p class="text-slateTextMuted line-clamp-2">
                                <strong class="text-red-400">التحدي:</strong> ${project.challenge}
                            </p>
                            <p class="text-slateTextMuted line-clamp-2">
                                <strong class="text-indigoAccent">الحل:</strong> ${project.solution}
                            </p>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-slate-800/80 mt-6 flex items-center justify-between">
                        <button onclick="openProjectModal(${id})" class="w-full py-3 rounded-xl bg-slate-900 group-hover:bg-indigoAccent text-slateTextPrimary group-hover:text-white font-bold text-xs transition-all flex items-center justify-center gap-2 border border-slate-700/80 group-hover:border-indigoAccent">
                            <span>عرض دراسة الحالة والمعرض التفاعلي</span>
                            <i class="fas fa-arrow-left"></i>
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function filterProjects(group) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-indigoAccent', 'text-white');
                btn.classList.add('bg-slateDark', 'text-slateTextMuted');
            });
            event.currentTarget.classList.add('active', 'bg-indigoAccent', 'text-white');
            event.currentTarget.classList.remove('bg-slateDark', 'text-slateTextMuted');
            
            renderProjectsGrid(group);
        }

        const projectModal = document.getElementById('projectModal');

        function openProjectModal(id) {
            const data = projectsData[id];
            if (!data) return;

            document.getElementById('modalTitle').innerText = data.title;
            document.getElementById('modalCountryBadge').innerText = data.country;
            document.getElementById('modalCategory').innerText = data.category;
            document.getElementById('modalChallenge').innerText = data.challenge;
            document.getElementById('modalSolution').innerText = data.solution;
            document.getElementById('modalExecution').innerText = data.execution;

            // Populate Images Grid
            const imagesContainer = document.getElementById('modalImagesContainer');
            imagesContainer.innerHTML = '';
            if (data.images && data.images.length > 0) {
                data.images.forEach(img => {
                    const imgCard = document.createElement('div');
                    imgCard.className = "group relative rounded-xl overflow-hidden bg-slate-800 border border-slate-700/60 cursor-pointer aspect-square hover:border-indigoAccent transition-all";
                    imgCard.onclick = () => openLightbox(img.url, img.caption);
                    imgCard.innerHTML = `
                        <img src="${img.url}" alt="${img.caption}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-2 flex flex-col justify-end text-[11px] text-slateTextPrimary font-medium">
                            <span class="truncate"><i class="fas fa-magnifying-glass-plus me-1 text-goldAccent"></i> ${img.caption}</span>
                        </div>
                    `;
                    imagesContainer.appendChild(imgCard);
                });
            } else {
                imagesContainer.innerHTML = `<p class="text-xs text-slateTextMuted col-span-full py-2">لا تتوفر صور إضافية لهذا المشروع حالياً.</p>`;
