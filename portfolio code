                data.captions.forEach(cap => {
                    const capCard = document.createElement('div');
                    capCard.className = "p-4 rounded-xl bg-slate-800/60 border border-slate-700/80 space-y-2";
                    capCard.innerHTML = `
                        <div class="flex items-center justify-between text-xs border-b border-slate-700/50 pb-2">
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 font-bold border border-indigo-500/20">${cap.type}</span>
                            <span class="font-bold text-goldAccent">${cap.title}</span>
                        </div>
                        <p class="text-xs text-slateTextMuted leading-relaxed whitespace-pre-line font-mono bg-slate-900/60 p-3 rounded-lg border border-slate-800">${cap.copy}</p>
                    `;
                    captionsContainer.appendChild(capCard);
                });
            } else {
                captionsContainer.innerHTML = `<p class="text-xs text-slateTextMuted py-2">لا تتوفر نماذج نصية إضافية لهذا المشروع.</p>`;
            }

            // Generate Action Link Buttons
            const buttonsContainer = document.getElementById('modalButtonsContainer');
            buttonsContainer.innerHTML = '';

            if (data.strategyLink) {
                const stratBtn = document.createElement('button');
                stratBtn.type = "button";
                stratBtn.onclick = () => showCustomNotice('ملف الاستراتيجية', 'يمكنك استبدال هذا التنبيه بالرابط المباشر لملف PDF أو Drive الخاص باستراتيجية مشروع ' + data.title);
                stratBtn.className = "px-5 py-3 rounded-xl bg-indigoAccent hover:bg-indigoHover text-white font-bold text-xs sm:text-sm transition-all flex items-center justify-center gap-2 shadow-lg";
                stratBtn.innerHTML = `<i class="fas fa-file-pdf"></i> <span>📄 اضغط هنا للاطلاع على ملف الاستراتيجية الشاملة</span>`;
                buttonsContainer.appendChild(stratBtn);
            }

            if (data.dashboardLink) {
                const dashBtn = document.createElement('button');
                dashBtn.type = "button";
                dashBtn.onclick = () => showCustomNotice('لوحة النتائج الإحصائية', 'يمكنك ربط هذا الزر برابط Dashboard المباشر أو نتائج أداء حملة ' + data.title);
                dashBtn.className = "px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold text-xs sm:text-sm transition-all flex items-center justify-center gap-2 shadow-lg";
                dashBtn.innerHTML = `<i class="fas fa-chart-pie"></i> <span>📊 اضغط هنا لعرض نتائج الحملة والـ Dashboard</span>`;
                buttonsContainer.appendChild(dashBtn);
            }

            projectModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeProjectModal() {
            projectModal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function openLightbox(url, caption) {
            document.getElementById('lightboxImg').src = url;
            document.getElementById('lightboxCaption').innerText = caption || '';
            document.getElementById('imageLightbox').classList.remove('hidden');
        }

        function closeLightbox() {
            document.getElementById('imageLightbox').classList.add('hidden');
        }

        function showCustomNotice(title, body) {
            document.getElementById('noticeTitle').innerText = title;
            document.getElementById('noticeBody').innerText = body;
            document.getElementById('noticeModal').classList.remove('hidden');
        }

        function closeCustomNotice() {
            document.getElementById('noticeModal').classList.add('hidden');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        function copyToClipboard(text, successMessage) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showCustomNotice('تم النسخ بنجاح', successMessage);
        }

        // Initialize projects grid on window load
        window.onload = function() {
            renderProjectsGrid('all');
            document.getElementById('mobileMenuBtn').addEventListener('click', toggleMobileMenu);
        };
    </script>
</body>
</html>
